generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}


model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String?
  password    String
  telephone   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        Role     @default(USER)

   profile     Profile?
}

model Profile {
  id        Int    @id @default(autoincrement())
  bio       String?
  address   String?

  userId    Int    @unique
  user      User   @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
}